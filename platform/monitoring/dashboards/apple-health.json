    {
      "type": "heatmap",
      "title": "训练心率热力图",
      "description": "横轴为日期，纵轴为当地小时，颜色表示该小时内已记录的平均心率。",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "apple-health-influxdb"
          },
          "query": "import \"timezone\"\nimport \"date\"\noption location = timezone.location(name: \"Asia/Shanghai\")\n\nfrom(bucket: \"apple-health\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"heart_rate_data_bpm\" and r._field == \"qty\")\n  |> group()\n  |> aggregateWindow(every: 1h, fn: mean, createEmpty: false, timeSrc: \"_start\")\n  |> map(fn: (r) => ({\n    _time: date.truncate(t: r._time, unit: 1d),\n    _value: r._value,\n    _field: if date.hour(t: r._time) < 10 then \"0\" + string(v: date.hour(t: r._time)) else string(v: date.hour(t: r._time)),\n  }))\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: bpm"
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "rowsFrame": {
          "layout": "unknown"
        },
        "cellGap": 0,
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "axisLabel": "小时"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Magma",
          "steps": 64,
          "exponent": 0.5,
          "reverse": false
        },
        "legend": {
