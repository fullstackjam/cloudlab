      "title": "步数 · 最近记录日",
      "description": "选定范围内最近有同步数据的一天。",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "apple-health-influxdb"
          },
          "query": "import \"timezone\"\noption location = timezone.location(name: \"Asia/Shanghai\")\n\nfrom(bucket: \"apple-health\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"step_count_count\" and r._field == \"qty\")\n  |> group()\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: false, timeSrc: \"_start\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
